# Copy to .env. These are local examples, not production credentials.
# Generate distinct passwords and a shared 32+ byte JWT secret before deployment.
SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=local-root-password
# Dedicated account for services in the full Phase 2 Compose stack.
MYSQL_APP_USER=clinic_app
MYSQL_APP_PASSWORD=replace-with-a-strong-mysql-app-password
# Host-run Phase 1 defaults.
MYSQL_HOST=localhost
MYSQL_PORT=3306
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=clinic
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password

# Host-run Phase 1 service ports.
GATEWAY_PORT=8081
AUTH_SERVICE_PORT=8082
SLOT_SERVICE_PORT=8083
APPOINTMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_DOCKER=http://localhost
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
# Initial account seed values for the Phase 2 prod profile. Replace each hash
# with a BCrypt hash generated for a different strong password.
INITIAL_ADMIN_NAME=Clinic Administrator
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash-before-starting
INITIAL_DOCTOR_ONE_NAME=Doctor One
INITIAL_DOCTOR_ONE_EMAIL=doctor1@example.invalid
INITIAL_DOCTOR_ONE_PASSWORD_HASH=replace-with-bcrypt-hash-before-starting
INITIAL_DOCTOR_TWO_NAME=Doctor Two
INITIAL_DOCTOR_TWO_EMAIL=doctor2@example.invalid
INITIAL_DOCTOR_TWO_PASSWORD_HASH=replace-with-bcrypt-hash-before-starting

# Per-service schema names.
AUTH_DB_NAME=auth_db
SLOT_DB_NAME=slot_db
APPOINTMENT_DB_NAME=appointment_db
NOTIFICATION_DB_NAME=notification_db
# Phase 1 uses the local MySQL root account. Phase 2 Compose overrides these
# with MYSQL_APP_USER and MYSQL_APP_PASSWORD for least-privilege app access.
DB_USERNAME=root
DB_PASSWORD=local-root-password

# Phase 1 browser and service URL defaults.
VITE_API_BASE_URL=http://localhost:8081
AUTH_SERVICE_URL=http://localhost:8082
SLOT_SERVICE_URL=http://localhost:8083
APPOINTMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
# Docker DNS addresses for the Compose network (do not use localhost here).
MYSQL_DOCKER_HOST=mysql
REDIS_DOCKER_HOST=redis
RABBITMQ_DOCKER_HOST=rabbitmq
AUTH_SERVICE_DOCKER_URL=http://auth-service:8082
SLOT_SERVICE_DOCKER_URL=http://slot-service:8083
APPOINTMENT_SERVICE_DOCKER_URL=http://appointment-service:8084
NOTIFICATION_SERVICE_DOCKER_URL=http://notification-service:8085
REMINDER_INTERVAL_MS=60000

# Phase 2 public ports. The browser uses /api through Nginx in the image.
HTTP_PORT=80
